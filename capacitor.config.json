{
  "appId": "com.atmr.drop",
  "appName": "ATMR Drop",
  "webDir": "public",
  "bundledWebRuntime": false,
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0A",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0A0A0A",
      "showSpinner": false
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
